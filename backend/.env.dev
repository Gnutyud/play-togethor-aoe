# Development Environment Configuration
 
# MongoDB - Use local MongoDB or development cluster
MONGODB_URI=mongodb://localhost:27017/aoe-launcher-dev
# Or for MongoDB Atlas development cluster:
# MONGODB_URI=mongodb+srv://dev-user:dev-password@dev-cluster.mongodb.net/aoe-launcher-dev?retryWrites=true&w=majority
 
# JWT Secrets (Development - Less strict)
JWT_SECRET=dev-jwt-secret-key-for-development-only
JWT_REFRESH_SECRET=dev-refresh-secret-key-for-development-only
 
# Radmin VPN Networks (Network1-10 for default rooms)
# Development networks - use test networks
RADMIN_NETWORK_1_ID=dev-network-1-id
RADMIN_NETWORK_1_PASSWORD=dev-network1-pass
RADMIN_NETWORK_2_ID=dev-network-2-id
RADMIN_NETWORK_2_PASSWORD=dev-network2-pass
RADMIN_NETWORK_3_ID=dev-network-3-id
RADMIN_NETWORK_3_PASSWORD=dev-network3-pass
RADMIN_NETWORK_4_ID=dev-network-4-id
RADMIN_NETWORK_4_PASSWORD=dev-network4-pass
RADMIN_NETWORK_5_ID=dev-network-5-id
RADMIN_NETWORK_5_PASSWORD=dev-network5-pass
RADMIN_NETWORK_6_ID=dev-network-6-id
RADMIN_NETWORK_6_PASSWORD=dev-network6-pass
RADMIN_NETWORK_7_ID=dev-network-7-id
RADMIN_NETWORK_7_PASSWORD=dev-network7-pass
RADMIN_NETWORK_8_ID=dev-network-8-id
RADMIN_NETWORK_8_PASSWORD=dev-network8-pass
RADMIN_NETWORK_9_ID=dev-network-9-id
RADMIN_NETWORK_9_PASSWORD=dev-network9-pass
RADMIN_NETWORK_10_ID=dev-network-10-id
RADMIN_NETWORK_10_PASSWORD=dev-network10-pass
 
# App Config
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000
 
# Development Settings
DEBUG=true
LOG_LEVEL=debug
 