# Production Environment Configuration
 
# MongoDB - Production cluster with authentication
MONGODB_URI=mongodb+srv://prod-user:CHANGE_ME@prod-cluster.mongodb.net/aoe-launcher?retryWrites=true&w=majority&authSource=admin
 
# JWT Secrets (Production - MUST BE CHANGED!)
# Generate secure secrets with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_SECURE_RANDOM_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_TO_SECURE_RANDOM_REFRESH_SECRET
 
# Radmin VPN Networks (Network1-10 for default rooms)
# IMPORTANT: Replace with actual production Radmin VPN network credentials
RADMIN_NETWORK_1_ID=CHANGE_ME_NETWORK_1_ID
RADMIN_NETWORK_1_PASSWORD=CHANGE_ME_NETWORK_1_PASSWORD
RADMIN_NETWORK_2_ID=CHANGE_ME_NETWORK_2_ID
RADMIN_NETWORK_2_PASSWORD=CHANGE_ME_NETWORK_2_PASSWORD
RADMIN_NETWORK_3_ID=CHANGE_ME_NETWORK_3_ID
RADMIN_NETWORK_3_PASSWORD=CHANGE_ME_NETWORK_3_PASSWORD
RADMIN_NETWORK_4_ID=CHANGE_ME_NETWORK_4_ID
RADMIN_NETWORK_4_PASSWORD=CHANGE_ME_NETWORK_4_PASSWORD
RADMIN_NETWORK_5_ID=CHANGE_ME_NETWORK_5_ID
RADMIN_NETWORK_5_PASSWORD=CHANGE_ME_NETWORK_5_PASSWORD
RADMIN_NETWORK_6_ID=CHANGE_ME_NETWORK_6_ID
RADMIN_NETWORK_6_PASSWORD=CHANGE_ME_NETWORK_6_PASSWORD
RADMIN_NETWORK_7_ID=CHANGE_ME_NETWORK_7_ID
RADMIN_NETWORK_7_PASSWORD=CHANGE_ME_NETWORK_7_PASSWORD
RADMIN_NETWORK_8_ID=CHANGE_ME_NETWORK_8_ID
RADMIN_NETWORK_8_PASSWORD=CHANGE_ME_NETWORK_8_PASSWORD
RADMIN_NETWORK_9_ID=CHANGE_ME_NETWORK_9_ID
RADMIN_NETWORK_9_PASSWORD=CHANGE_ME_NETWORK_9_PASSWORD
RADMIN_NETWORK_10_ID=CHANGE_ME_NETWORK_10_ID
RADMIN_NETWORK_10_PASSWORD=CHANGE_ME_NETWORK_10_PASSWORD
 
# App Config
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://your-production-domain.com
 
# Production Settings
DEBUG=false
LOG_LEVEL=error